# Copy this file to .env and fill in the real value. .env is gitignored and
# must never be committed - this repository is public.

# The Supabase PostgreSQL connection string. The MCP server reuses this same
# DATABASE_URL; it has no separate database setting.
#
# Supabase offers three, and only one of them is right here. In the dashboard,
# click Connect at the top of the page and choose "Session pooler".
#
#   Session pooler      aws-0-eu-central-1.pooler.supabase.com:5432   <- this one
#   Transaction pooler  aws-0-eu-central-1.pooler.supabase.com:6543   no
#   Direct connection   db.<your-project-ref>.supabase.co:5432        no
#
# Why not the direct connection: on the free plan it is IPv6-only, and GitHub
# Actions runners are IPv4-only. It works on your machine and fails in CI.
#
# Why not the transaction pooler: it does not support prepared statements, and
# psycopg prepares a statement automatically once it has seen the same query
# five times. A bulk load would run for a few batches and then start failing.
#
# The session pooler is IPv4 and otherwise behaves like a direct connection.
# The code rejects the other two with an explanation, so a wrong paste is
# caught immediately rather than halfway through loading a season.
#
# It looks like this:
#   postgresql://postgres.<your-project-ref>:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Private Supabase Storage archive. Copy the project URL and the server-only
# service_role key from Project Settings, API. Never use this key in a browser,
# print it, or commit the populated .env file.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=euroleague-api-archive

# The hosted HTTP server only. A local stdio user needs none of these.
# MCP_RESOURCE_URL is this server's own public URL and must end in /mcp.
MCP_ISSUER_URL=https://<your-identity-provider>
MCP_RESOURCE_URL=https://<your-app>.fly.dev/mcp
MCP_INTROSPECTION_URL=https://<your-identity-provider>/oauth2/introspect
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Optional, and empty on purpose. The server always requires that a token's
# audience names it and that its issuer is MCP_ISSUER_URL; neither has a switch.
# This variable adds a third requirement - that the token carries a named scope -
# and it is off until somebody has observed a real token carrying one. Turning on
# a check that nothing has been seen to pass locks you out of your own server.
# See DECISIONS.md item 34, and scripts/check_hosted_token.py for the observation.
MCP_REQUIRED_SCOPE=

# Optional. The host names the server will answer to, comma separated. Left
# empty it derives the single host from MCP_RESOURCE_URL, which is what you want
# unless the server is reached by more than one name. This is DNS rebinding
# protection: a browser page on another site cannot make your machine's browser
# talk to this server under a name the server does not expect.
MCP_ALLOWED_HOSTS=

# Optional and OpenAI-submission-only. The OpenAI plugin submission portal
# provides this token while verifying control of the hosted MCP domain. When
# empty, the well-known challenge route does not exist. Remove the value after
# verification unless the portal asks you to keep serving it.
OPENAI_APPS_CHALLENGE_TOKEN=

# Local only, and it refuses to be anything else. The incremental-derived
# confirmation runs against a disposable PostgreSQL on this machine and checks
# the database name and port before connecting, so a stray value cannot point a
# confirmation run at production. Leave empty unless you are running that check.
EL_TEST_DATABASE_URL=


# The credential handed to a human tester, created by migration 0020 as the
# `el_tester` role. It reads exactly what the hosted server serves and can write
# nothing. It is deliberately NOT `el_reader`: that one is the server's own
# credential, and rotating it after a tester's copy leaks would interrupt
# production. Leave empty unless you are running tests/test_tester_role.py.
# See DECISIONS.md item 43.
TESTER_DATABASE_URL=

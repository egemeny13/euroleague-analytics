# Copy this file to .env and fill in the real value. .env is gitignored and
# must never be committed - this repository is public.

# The Supabase PostgreSQL connection string.
#
# Use the POOLER string, not the direct one. In the Supabase dashboard:
#   Project Settings -> Database -> Connection pooling
#
# It looks like this:
#   postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#
# The direct host, db.<project-ref>.supabase.co, is rejected by the code on
# purpose. Free projects have no IPv4 address and GitHub Actions runners are
# IPv4-only, so the direct host works locally and fails only in CI.
DATABASE_URL=

# The raw API response cache. Archived to Supabase Storage instead - see
# DECISIONS.md item 9. 53 MB for one season; every clone would carry it forever.
exploration/cache/
exploration/sweep_results.json

# Internal strategy notes. Deliberately not published - see DECISIONS.md item 13.
CONTEXT.md

# Secrets. Never commit. See .env.example for the shape.
.env

# Machine-local symlinks into .agents/skills, created by the skills installer.
# The skills themselves are committed; these pointers are not portable.
#
# Written as `.claude/*` and not `.claude/`, which matters: git does not descend
# into an excluded directory, so a `!` re-include under a `.claude/` rule would
# never be reached.
.claude/*

# ...except the permission rules, which are a project decision rather than a
# machine detail. See DECISIONS.md item 46: without a committed rule the agent
# harness classifies each command on its own, and the same `gh pr merge` was
# allowed once and refused the next time.
!.claude/settings.json

# Repository-scoped pytest temporary directories. The desktop sandbox cannot
# reach pytest's machine-wide temp folder, so runs pass --basetemp .tmp/...
.tmp/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Machine-local Codex CLI environment config, autogenerated per checkout.
.codex/

# Stray pytest basetemp from a Codex sandbox run. The repo convention is .tmp/;
# this directory is owned by the sandbox user and cannot be deleted unelevated.
.pytest-tmp/
